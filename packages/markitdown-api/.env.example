# Copy to .env in the deployment environment. Do not commit actual secrets.
PUBLIC_BASE_URL=https://api.example.com
POSTGRES_DB=markitdown
POSTGRES_USER=markitdown
# Use URL-safe random values for these secrets (at least 32 characters).
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value
JWT_SECRET=replace-with-a-different-long-random-secret
API_KEY_PEPPER=replace-with-another-different-long-random-secret

# Email verification is required by default. Configure an SMTP relay.
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional OCR via Azure OpenAI. OCR remains unavailable unless all are set
# and the client explicitly submits ocr=true for a conversion.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_MODEL=

MAX_UPLOAD_BYTES=104857600
MAX_PENDING_JOBS=5
MAX_OUTPUT_BYTES=52428800
MAX_STORED_RESULT_BYTES=2147483648
MAX_CONVERSION_MEMORY_BYTES=536870912
MAX_ARCHIVE_ENTRIES=5000
MAX_ARCHIVE_EXPANDED_BYTES=134217728
WORKER_MEMORY_LIMIT=768m
WORKER_CPUS=1.0
RESULT_TTL_MINUTES=1440
CONVERSION_TIMEOUT_SECONDS=900
RATE_LIMIT_PER_MINUTE=30
